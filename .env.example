# Spotify App-Credentials aus dem Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=dein_client_id
SPOTIFY_CLIENT_SECRET=dein_client_secret

# Muss EXAKT so im Dashboard als Redirect-URI eingetragen sein.
# Wichtig: 127.0.0.1, NICHT localhost (Spotify verbietet localhost seit Nov 2025).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Port, auf dem der Server laeuft
PORT=8888

# Markt fuer die Katalog-Suche (CH = Schweiz)
MARKET=CH

# Playlist, aus der der Auto-Fill-Pool gebaut wird. Nur die ID, nicht die ganze URL.
# Steht im Share-Link: open.spotify.com/playlist/<ID>?si=...
# Muss oeffentlich lesbar sein, dann reicht der App-Token (kein zusaetzlicher Scope).
# Leer lassen => es wird nur die kuratierte MOOD_POOL-Liste in server.js verwendet.
SPOTIFY_PLAYLIST_ID=7n18x8ELn4t0tKS1cbiksl

# Horn/Troete: URI des Effekts (Episode ODER Track). Als Track-URI notfalls
# robuster: spotify:track:<ID>. Kein eigenes Intervall mehr — das Horn laeuft
# einmal pro Musikrichtungs-Block, direkt vor dem Lieblingslied des Voting-
# Gewinners. Steuerung im DJ-Panel (Button "Horn an/aus").
HORN_URI=spotify:episode:7i8ANZDp3UtjiGPJoKXP5f

# Laenge eines Musikrichtungs-Blocks in Minuten. An dessen Ende haengt die ganze
# Sequenz: auf dem letzten Lied der alten Richtung startet das Gaeste-Voting
# ("wer bestimmt den naechsten Song", 4 zufaellige Namen aus guests.csv), danach
# kommen Horn und das Lieblingslied des Gewinners, und erst dann dreht die
# Richtung. Voting laesst sich im DJ-Panel abschalten ("Voting an/aus").
DIRECTION_CYCLE_MIN=30

# Mitternachtslied: laeuft jede Nacht um 00:00 Ortszeit, quer zur laufenden
# Musikrichtung. Es unterbricht nichts — Horn und Lied gehen um 00:00 in die
# Queue und laufen, sobald der aktuelle Song durch ist. Der 30-Min-Block startet
# danach neu, ab 5 Min vor 00:00 beginnt keine Wechsel-Sequenz mehr.
# Leer lassen => ganz aus.
MIDNIGHT_URI=spotify:track:12LkVK4F1Tq0bLtzl7wkpf

# Zeitzone, nach der "Mitternacht" bestimmt wird. Render laeuft in UTC, darum
# hier explizit setzen — sonst kaeme das Lied um 02:00 Schweizer Zeit.
MIDNIGHT_TZ=Europe/Zurich

# Zweitkatalog fuer Interpreten, zu denen Spotify keine Genres liefert (kleine
# Acts, CH-Rap, Newcomer). Ohne das landen die still in Party-Charts.
# "lastfm" (Standard, sobald LASTFM_KEY gesetzt ist), "musicbrainz" (ohne Key,
# dafuer duenner und langsam) oder "off". Wird nur bei komplett leeren Spotify-
# Genres angefragt, pro Interpret einmal, mit Timeout – faellt sauber aus.
# Key gratis und sofort: https://www.last.fm/api/account/create
LASTFM_KEY=
EXTERNAL_TAGS=lastfm

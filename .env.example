# Spotify App-Credentials aus dem Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=dein_client_id
SPOTIFY_CLIENT_SECRET=dein_client_secret

# Muss EXAKT so im Dashboard als Redirect-URI eingetragen sein.
# Wichtig: 127.0.0.1, NICHT localhost (Spotify verbietet localhost seit Nov 2025).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Port, auf dem der Server laeuft
PORT=8888

# Markt fuer die Katalog-Suche (CH = Schweiz)
MARKET=CH
